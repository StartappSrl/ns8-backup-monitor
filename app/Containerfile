#
# Container image for backup-monitor's backend: runs the IMAP poller AND
# serves the web dashboard (login + reports) in a single process (see
# main.py). This is the "workload" image referenced by
# org.nethserver.images in the module's build-images.sh. It is a normal,
# standalone container image (unlike the module's own scratch-based
# image, which only ships imageroot/ and ui/dist and is never actually
# run as a workload).
#
FROM docker.io/library/python:3.12-slim

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY parsing.py poller.py db.py authlib.py webapp.py main.py ./
COPY templates ./templates

# Deliberately NOT dropping to a non-root user here: /state is a bind
# mount of the module's own host-side state directory (owned by the
# module's unprivileged system user), and under rootless Podman a
# non-root container user cannot reliably write to a bind-mounted host
# directory it doesn't numerically own. Running as root INSIDE the
# container is safe here: rootless Podman maps container root back to
# the unprivileged host user that started the container, so this never
# grants real host privileges - it's the standard pattern for
# NS8/rootless-Podman modules that need to write to their own state dir.
VOLUME ["/state"]
EXPOSE 8080

ENTRYPOINT ["python3", "/app/main.py"]
