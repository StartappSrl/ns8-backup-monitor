import json
import os
import sys

ENV_FILE = "config.env"  # relative to the module state directory (CWD)


def read_env():
    values = {}
    if os.path.exists(ENV_FILE):
        with open(ENV_FILE) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                values[key] = value
    return values


env = read_env()

config = {
    "imap_host": env.get("IMAP_HOST", ""),
    "imap_port": int(env.get("IMAP_PORT", "993") or 993),
    "imap_ssl": env.get("IMAP_SSL", "true") == "true",
    "imap_username": env.get("IMAP_USERNAME", ""),
    "imap_password_set": bool(env.get("IMAP_PASSWORD")),
    "imap_folder": env.get("IMAP_FOLDER", "INBOX"),
    "sender_filter": env.get("IMAP_SENDER_FILTER", ""),
    "poll_interval": int(env.get("POLL_INTERVAL", "300") or 300),
}

json.dump(config, fp=sys.stdout)
