{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "list-reports output",
    "$id": "http://schema.nethserver.org/backup-monitor/list-reports-output.json",
    "type": "object",
    "properties": {
        "reports": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "natural_key": {"type": "string"},
                    "source": {"type": "string"},
                    "timestamp": {"type": "string"},
                    "user": {"type": "string"},
                    "backup_set": {"type": "string"},
                    "destination": {"type": "string"},
                    "status": {"type": "string"},
                    "data_size": {"type": "string"},
                    "ip_address": {"type": "string"},
                    "start_end": {"type": "string"},
                    "job_id": {"type": "string"},
                    "severity": {"type": "string"},
                    "received_at": {"type": "string"}
                }
            }
        },
        "summary": {
            "type": "object",
            "properties": {
                "CRITICAL": {"type": "integer"},
                "WARNING": {"type": "integer"},
                "OK": {"type": "integer"},
                "INFO": {"type": "integer"}
            }
        },
        "destinations": {
            "type": "array",
            "items": {"type": "string"}
        }
    }
}
