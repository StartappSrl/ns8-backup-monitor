import json
import os
import stat
import sys

import agent
import agent.tasks

request = json.load(sys.stdin)

ENV_FILE = "config.env"  # relative to the module state directory (CWD)


def read_existing_env():
    values = {}
    if os.path.exists(ENV_FILE):
        with open(ENV_FILE) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                values[key] = value
    return values


existing = read_existing_env()

imap_password = request.get("imap_password")
if not imap_password:
    # keep the previously stored password if a new one wasn't provided
    imap_password = existing.get("IMAP_PASSWORD", "")

# imap_password is required the first time the module is configured,
# afterwards it can be omitted to keep the stored value
agent.assert_exp(bool(imap_password))

env_values = {
    "IMAP_HOST": request["imap_host"],
    "IMAP_PORT": str(request.get("imap_port", 993)),
    "IMAP_SSL": "true" if request.get("imap_ssl", True) else "false",
    "IMAP_USERNAME": request["imap_username"],
    "IMAP_PASSWORD": imap_password,
    "IMAP_FOLDERS": ",".join(request.get("imap_folders") or ["INBOX"]),
    "IMAP_SENDER_FILTERS": ",".join(request["sender_filters"]),
    "POLL_INTERVAL": str(request.get("poll_interval", 300)),
    "RETENTION_DAYS": str(request.get("retention_days", 15)),
    "FQDN": request["fqdn"].strip().lower(),
}

with open(ENV_FILE, "w") as f:
    for key, value in env_values.items():
        f.write(f"{key}={value}\n")

# the file contains a plaintext IMAP password: keep it readable only by
# the module's own user
os.chmod(ENV_FILE, stat.S_IRUSR | stat.S_IWUSR)

# Expose the web dashboard (login + reports) at the given FQDN via Traefik.
# This is a dedicated virtual host (not a subpath under the cluster's own
# domain), since the dashboard has its own login/MFA and is meant to be
# reached directly, independently of the NS8 admin UI.
fqdn = env_values["FQDN"]
response = agent.tasks.run(
    agent_id=agent.resolve_agent_id('traefik@node'),
    action='set-route',
    data={
        'instance': os.environ['MODULE_ID'],
        'url': 'http://127.0.0.1:' + os.environ["TCP_PORT"],
        'host': fqdn,
        'http2https': True,
        'lets_encrypt': True,
    },
)
agent.assert_exp(response['exit_code'] == 0)

print(json.dumps({"configured": True, "fqdn": fqdn}))
