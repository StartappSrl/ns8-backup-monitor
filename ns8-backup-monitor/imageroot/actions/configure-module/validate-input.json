{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "configure-module input",
    "$id": "http://schema.nethserver.org/backup-monitor/configure-module-input.json",
    "description": "Configure the IMAP mailbox backup-monitor should poll",
    "type": "object",
    "properties": {
        "imap_host": {
            "type": "string",
            "minLength": 1
        },
        "imap_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "default": 993
        },
        "imap_ssl": {
            "type": "boolean",
            "default": true
        },
        "imap_username": {
            "type": "string",
            "minLength": 1
        },
        "imap_password": {
            "type": "string",
            "description": "Only required the first time, or to change it. Omit to keep the current password."
        },
        "imap_folders": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1,
            "default": ["INBOX"],
            "description": "IMAP folders to check"
        },
        "sender_filters": {
            "type": "array",
            "items": {"type": "string", "format": "email"},
            "minItems": 1,
            "description": "Only emails from these addresses are analyzed"
        },
        "poll_interval": {
            "type": "integer",
            "minimum": 30,
            "default": 300,
            "description": "Seconds between two IMAP checks"
        },
        "retention_days": {
            "type": "integer",
            "minimum": 1,
            "default": 15,
            "description": "How many days of report history to keep before automatic cleanup"
        },
        "fqdn": {
            "type": "string",
            "description": "Public FQDN the reports dashboard (login + MFA) will be reachable at, e.g. backup-monitor.example.org. Must already point to this NS8 node."
        }
    },
    "required": ["imap_host", "imap_username", "sender_filters", "fqdn"],
    "examples": [
        {
            "imap_host": "mail.example.org",
            "imap_port": 993,
            "imap_ssl": true,
            "imap_username": "support@example.org",
            "imap_password": "secret",
            "imap_folders": ["INBOX", "Backup Reports"],
            "sender_filters": ["backup@1backup.it", "noreply@veeam.example"],
            "poll_interval": 300,
            "retention_days": 15,
            "fqdn": "backup-monitor.example.org"
        }
    ]
}
